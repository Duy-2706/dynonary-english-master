+
+// ---------------------------------------------------------------------------
+// Main Game Component
+// ---------------------------------------------------------------------------
+
+const N_QUESTIONS = 15;
+const CORRECT_PTS = 100;
+const STREAK_BONUS = 100;
+const STREAK_THRESHOLD = 3;
+
+function MountainClimbGame() {
+  const [wordPack, setWordPack] = useState([]);
+  const [current, setCurrent] = useState(0);
+  const [choices, setChoices] = useState([]);
+  // progress: 0..1 (how high the climber is, in units of 1/N_QUESTIONS steps)
+  const [progressSteps, setProgressSteps] = useState(0);
+  const [score, setScore] = useState(0);
+  const [streak, setStreak] = useState(0);
+  const [selectedIndex, setSelectedIndex] = useState(null); // index in choices[]
+  const [status, setStatus] = useState('loading'); // loading | playing | answered | done
+  const [feedback, setFeedback] = useState(null); // { ok, correctWord }
+  const [error, setError] = useState(null);
+  const advanceRef = useRef(null);
+
+  // ---- Data fetch ----
+  const initGame = useCallback(async () => {
+    setStatus('loading');
+    setError(null);
+    setCurrent(0);
+    setProgressSteps(0);
+    setScore(0);
+    setStreak(0);
+    setSelectedIndex(null);
+    setFeedback(null);
+    if (advanceRef.current) clearTimeout(advanceRef.current);
+
+    try {
+      const res = await gameApi.getWordPackCWG(
+        undefined, undefined, undefined, [], N_QUESTIONS,
+      );
+      const pack = (res?.data?.wordPack || []).slice(0, N_QUESTIONS);
+      if (pack.length === 0) throw new Error('empty');
+      setWordPack(pack);
+      setChoices(buildChoices(pack[0]));
+      setStatus('playing');
+    } catch {
+      setError('Không thể tải dữ liệu. Vui lòng thử lại!');
+      setStatus('error');
+    }
+  }, []);
+
+  useEffect(() => {
+    initGame();
+    return () => {
+      if (advanceRef.current) clearTimeout(advanceRef.current);
+    };
+  }, [initGame]);
+
+  // ---- Handle answer ----
+  const handleChoice = useCallback((choiceWord, idx) => {
+    if (status !== 'playing') return;
+
+    const item = wordPack[current];
+    if (!item) return;
+
+    const isCorrect = choiceWord === item.word;
+    setSelectedIndex(idx);
+    setStatus('answered');
+
+    if (isCorrect) {
+      const newStreak = streak + 1;
+      setStreak(newStreak);
+      const bonus = newStreak > 0 && newStreak % STREAK_THRESHOLD === 0 ? STREAK_BONUS : 0;
+      setScore((s) => s + CORRECT_PTS + bonus);
+      setProgressSteps((p) => Math.min(p + 1, N_QUESTIONS));
+      setFeedback({
+        ok: true,
+        correctWord: item.word,
+        bonus,
+      });
+    } else {
+      setStreak(0);
+      setProgressSteps((p) => Math.max(0, p - 1));
+      setFeedback({ ok: false, correctWord: item.word });
+    }
+
+    // Advance after delay
+    advanceRef.current = setTimeout(() => {
+      const next = current + 1;
+      if (next >= wordPack.length) {
+        setStatus('done');
+      } else {
+        setCurrent(next);
+        setChoices(buildChoices(wordPack[next]));
+        setSelectedIndex(null);
+        setFeedback(null);
+        setStatus('playing');
+      }
+    }, isCorrect ? 800 : 1000);
+  }, [status, wordPack, current, streak]);
+
+  // ---- Derived values ----
+  const progressPct = progressSteps / N_QUESTIONS;
+
+  // ---- Render helpers ----
+  function getChoiceState(choiceWord, idx) {
+    if (status !== 'answered') return 'idle';
+    const correctWord = wordPack[current]?.word;
+    if (choiceWord === correctWord) return 'correct';
+    if (idx === selectedIndex) return 'wrong';
+    return 'dimmed';
+  }
+
+  // ---- Loading ----
+  if (status === 'loading') {
+    return (
+      <div style={S.page}>
+        <style>{ANIM_STYLE}</style>
