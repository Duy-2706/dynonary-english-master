+            const c2 = currentCards.find((c) => c.id === id2);
+            if (!c1 || !c2) {
+              blockRef.current = false;
+              return currentCards;
+            }
+
+            if (c1.pairId === c2.pairId) {
+              // Match!
+              const updated = currentCards.map((c) =>
+                c.id === id1 || c.id === id2 ? { ...c, matched: true, flipped: true } : c,
+              );
+              setScore((s) => s + 100);
+              setMatchedCount((mc) => {
+                const newCount = mc + 1;
+                if (newCount >= totalPairs) setStatus('done');
+                return newCount;
+              });
+              setFlippedIds([]);
+              blockRef.current = false;
+              return updated;
+            } else {
+              // No match — flip back
+              const updated = currentCards.map((c) =>
+                c.id === id1 || c.id === id2 ? { ...c, flipped: false } : c,
+              );
+              setFlippedIds([]);
+              blockRef.current = false;
+              return updated;
+            }
+          });
+        }, 1000);
+      }
+
+      return next;
+    });
+
+    // Flip the clicked card immediately
+    setCards((prev) =>
+      prev.map((c) => (c.id === id ? { ...c, flipped: true } : c)),
+    );
+  }, [status]);
+
+  return (
+    <div style={S.root}>
+      <style>{FLIP_STYLE}</style>
+
+      <h1 style={S.title}>🃏 Lật thẻ ghi nhớ</h1>
