+/**
+ * seedWords.js
+ * ─────────────────────────────────────────────────────────────────────────────
+ * Comprehensive vocabulary seeding script.
+ *
+ * Features:
+ *   - ~300 built-in words with Vietnamese translations, organized by topic + CEFR
