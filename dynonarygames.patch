+      const firstChoices = buildChoices(pack[0]);
+      setChoices(firstChoices);
+      setCorrectAnswer(pack[0].word);
+      setTimer(TIMER_SECONDS);
+      setStatus('playing');
+    } catch {
+      setError('Không thể tải dữ liệu. Vui lòng thử lại.');
+      setStatus('loading');
+    }
+  }, []);
