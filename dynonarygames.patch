+import React, { useState, useEffect, useCallback, useRef } from 'react';
+import gameApi from 'apis/gameApi';
+
+/* ─── Inline keyframe style ─────────────────────────────────── */
+const FLIP_STYLE = `
+  .mm-scene { perspective: 600px; }
+  .mm-card-inner {
+    position: relative;
+    width: 100%;
+    height: 100%;
+    transform-style: preserve-3d;
+    transition: transform 0.4s ease;
+  }
+  .mm-card-inner.flipped { transform: rotateY(180deg); }
+  .mm-face {
+    position: absolute;
+    inset: 0;
+    backface-visibility: hidden;
+    -webkit-backface-visibility: hidden;
+    border-radius: 12px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    padding: 8px;
+    box-sizing: border-box;
+    overflow: hidden;
+    word-break: break-word;
+    text-align: center;
+  }
+  .mm-back {
+    background: #1a237e;
+    border: 2px solid #3949ab;
+  }
+  .mm-front-en {
+    background: linear-gradient(135deg, #e91e63, #ff5722);
+    transform: rotateY(180deg);
+    border: 2px solid #ff8a65;
+  }
+  .mm-front-vn {
+    background: linear-gradient(135deg, #2196f3, #00bcd4);
+    transform: rotateY(180deg);
+    border: 2px solid #4fc3f7;
+  }
+  .mm-matched .mm-front-en,
+  .mm-matched .mm-front-vn {
+    border: 2px solid #66bb6a;
+    opacity: 0.65;
+  }
+  @keyframes mmPop {
+    0%   { transform: rotateY(180deg) scale(1); }
+    50%  { transform: rotateY(180deg) scale(1.08); }
+    100% { transform: rotateY(180deg) scale(1); }
+  }
+  .mm-matched .mm-card-inner { animation: mmPop 0.3s ease; }
+`;
+
+/* ─── Helpers ────────────────────────────────────────────────── */
+function shuffle(arr) {
+  return [...arr].sort(() => Math.random() - 0.5);
+}
+
+function buildCards(wordPack) {
+  const pairs = wordPack.flatMap((item, i) => [
+    { id: `en-${i}`, pairId: i, content: item.word, type: 'english' },
+    { id: `vn-${i}`, pairId: i, content: item.mean, type: 'vietnamese' },
+  ]);
+  return shuffle(pairs).map((c) => ({ ...c, flipped: false, matched: false }));
+}
+
+/* ─── Styles ─────────────────────────────────────────────────── */
+const S = {
+  root: {
+    minHeight: '100vh',
+    background: '#121212',
+    display: 'flex',
+    flexDirection: 'column',
+    alignItems: 'center',
+    padding: '28px 16px 48px',
+    fontFamily: "'Segoe UI', sans-serif",
+    boxSizing: 'border-box',
+  },
+  title: {
+    fontSize: 'clamp(1.5rem, 4vw, 2.2rem)',
+    fontWeight: 900,
+    color: '#fff',
+    margin: '0 0 12px',
+    textAlign: 'center',
