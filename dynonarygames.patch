+  const handleSkip = useCallback(() => {
+    if (status !== 'playing' && status !== 'checking') return;
+    setStatus('checking');
+    setFeedback('wrong');
+    setFlashColor('#fc5c65');
+
+    setTimeout(() => {
+      setFlashColor(null);
+      const next = current + 1;
+      if (next >= wordPack.length) {
+        setStatus('done');
+      } else {
+        setCurrent(next);
+        const { blankedWord: bw, blankedLetters: bl } = buildBlankedWord(wordPack[next].word);
+        setBlankedWord(bw);
+        setBlankedLetters(bl);
+        setUserInput('');
+        setFeedback(null);
+        setStatus('playing');
+      }
+    }, 900);
+  }, [current, status, wordPack]);
+
+  const handleKeyDown = (e) => {
+    if (e.key === 'Enter' && status === 'playing' && userInput.trim().length > 0) {
+      handleCheck();
+    }
+  };
+
+  // ---- Render states ----
+
+  if (status === 'loading') {
+    return (
+      <div style={S.page}>
+        <div style={S.card}>
+          <p style={{ color: '#fff', textAlign: 'center', fontSize: '1.1rem' }}>
+            Đang tải bộ từ...
+          </p>
+        </div>
+      </div>
+    );
+  }
+
+  if (status === 'error') {
+    return (
+      <div style={S.page}>
+        <div style={S.card}>
+          <p style={{ color: '#fc5c65', textAlign: 'center', fontSize: '1.1rem' }}>
+            Không thể tải bộ từ. Vui lòng thử lại.
+          </p>
+          <div style={{ textAlign: 'center', marginTop: '16px' }}>
+            <Link to="/games" style={S.backLink}>
+              Quay lại
+            </Link>
+          </div>
+        </div>
+      </div>
+    );
+  }
+
+  if (status === 'done') {
+    const maxScore = N_QUESTIONS * 100;
+    const pct = Math.round((score / maxScore) * 100);
+    const emoji = pct >= 80 ? '🏆' : pct >= 50 ? '🌟' : '💪';
+    return (
+      <div style={S.page}>
+        <div style={S.scoreCard}>
+          <div style={{ fontSize: '3.5rem' }}>{emoji}</div>
+          <h2 style={{ color: '#fff', fontSize: '1.6rem', margin: '12px 0 4px' }}>
+            Hoàn thành!
+          </h2>
+          <p style={{ color: 'rgba(255,255,255,0.55)', fontSize: '1rem', margin: '0 0 8px' }}>
+            Kết quả của bạn
+          </p>
+          <div style={S.scoreBig}>{score} điểm</div>
+          <p style={{ color: 'rgba(255,255,255,0.45)', marginBottom: '32px', fontSize: '0.95rem' }}>
+            {N_QUESTIONS} câu hỏi &nbsp;·&nbsp; Tối đa {maxScore} điểm
+          </p>
+          <Link to="/games" style={S.backLink}>
+            Chơi game khác
+          </Link>
+        </div>
+      </div>
+    );
+  }
+
+  const entry = wordPack[current];
+  if (!entry) return null;
+
+  const isChecking = status === 'checking';
+  const progressPct = Math.round(((current) / wordPack.length) * 100);
+
+  return (
+    <div style={S.page}>
+      <div style={S.card}>
+        {/* Header */}
+        <div style={S.header}>
+          <h2 style={S.title}>✏️ Điền chữ còn thiếu</h2>
+          <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
+            <span style={S.badge('rgba(255,255,255,0.12)')}>
+              Câu {current + 1}/{wordPack.length}
+            </span>
+            <span style={S.badge('#f7b731', '#1a1a2e')}>⭐ {score} điểm</span>
+          </div>
+        </div>
+
+        {/* Progress bar */}
+        <div style={S.progressBar(progressPct)} />
+
+        {/* Hint */}
+        <div style={S.hintLabel}>Nghĩa</div>
+        <div style={S.hintValue}>{entry.mean}</div>
+
+        {/* Word display with blanks */}
+        <div style={S.wordDisplayRow}>
+          {blankedWord.map((item, i) => {
+            if (!/[a-zA-Z]/.test(item.letter)) {
+              return (
+                <span key={i} style={S.nonAlpha}>
+                  {item.letter}
+                </span>
+              );
+            }
+            return (
+              <div key={i} style={S.letterBox(item.blanked, item.blanked ? flashColor : null)}>
+                {item.blanked ? '_' : item.letter}
+              </div>
+            );
+          })}
+        </div>
+
+        {/* Input area */}
+        <div style={S.inputLabel}>Nhập chữ bị thiếu (theo thứ tự):</div>
+        <div style={S.inputRow}>
+          <input
+            style={S.input(flashColor)}
+            type="text"
+            value={userInput}
+            onChange={(e) => !isChecking && setUserInput(e.target.value)}
+            onKeyDown={handleKeyDown}
+            placeholder={`${blankedLetters.length} chữ cái`}
+            disabled={isChecking}
+            autoFocus
+            autoComplete="off"
+            autoCorrect="off"
+            spellCheck={false}
+          />
+          <button
+            style={S.btn('rgba(255,255,255,0.1)', '#fff', isChecking)}
+            onClick={handleSkip}
+            disabled={isChecking}
+          >
+            Bỏ qua
+          </button>
+          <button
+            style={S.btn(
+              'linear-gradient(135deg, #f7b731, #f0932b)',
+              '#1a1a2e',
+              isChecking || userInput.trim().length === 0,
+            )}
+            onClick={handleCheck}
+            disabled={isChecking || userInput.trim().length === 0}
+          >
+            Kiểm tra
+          </button>
+        </div>
+
+        {/* Feedback */}
+        {feedback && (
+          <div style={S.feedback(feedback === 'correct')}>
+            {feedback === 'correct' ? (
+              <>✅ Chính xác! <strong>+100 điểm</strong></>
+            ) : (
+              <>❌ Sai rồi! Đáp án đúng: <strong style={{ letterSpacing: '2px' }}>{blankedLetters}</strong></>
+            )}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
+
+// ---------------------------------------------------------------------------
+// Page wrapper
+// ---------------------------------------------------------------------------
+
+function FillLettersPage() {
+  useTitle('Điền chữ còn thiếu (Fill Letters)');
+  useCloseNavigation();
+  return <FillLettersGame />;
+}
+
+export default FillLettersPage;
