+
+      <h1 style={S.title}>🏔️ Leo núi tiếng Anh</h1>
+
+      {/* Stats bar */}
+      <div style={S.statsRow}>
+        <span style={S.statBadge()}>
+          Câu {current + 1}/{N_QUESTIONS}
+        </span>
+        <span style={S.statBadge('rgba(255,211,42,0.2)')}>
+          ⭐ {score} điểm
+        </span>
+        <span style={S.streakBadge(streak)}>
+          🔥 {streak} liên tiếp
+          {streak >= STREAK_THRESHOLD && (
+            <span style={{ marginLeft: '4px', color: '#ffeaa7' }}>
+              +{STREAK_BONUS}!
+            </span>
+          )}
+        </span>
+      </div>
+
+      {/* Game area: mountain bar + question card */}
+      <div style={S.gameArea}>
+        {/* Mountain / Progress column */}
+        <div style={S.mountainCol}>
+          <span style={S.mountainEmoji}>🏔️</span>
+          <div style={S.barOuter}>
+            <div style={S.barFill(progressPct)} />
+            <div style={S.climber(progressPct)}>🧗</div>
+          </div>
+          <span style={S.pctLabel}>
+            {Math.round(progressPct * 100)}%
+          </span>
+        </div>
+
+        {/* Question card */}
+        <div style={S.card}>
+          <div style={S.questionLabel}>Từ nào có nghĩa là:</div>
+          <div style={S.questionText}>"{item.mean}"</div>
+
+          {/* Choices grid */}
+          <div style={S.choicesGrid}>
+            {choices.map((choiceWord, idx) => {
+              const state = getChoiceState(choiceWord, idx);
+              return (
+                <button
+                  key={idx}
+                  style={S.choiceBtn(CHOICE_COLORS[idx % CHOICE_COLORS.length], state)}
+                  onClick={() => handleChoice(choiceWord, idx)}
+                  disabled={status === 'answered'}
+                  onMouseOver={(e) => {
+                    if (status === 'playing') {
+                      e.currentTarget.style.transform = 'scale(1.04)';
+                    }
+                  }}
+                  onMouseOut={(e) => {
+                    if (status === 'playing') {
+                      e.currentTarget.style.transform = 'scale(1)';
+                    }
+                  }}
+                >
+                  {choiceWord}
+                </button>
+              );
+            })}
+          </div>
+
+          {/* Feedback */}
+          {feedback && (
+            <div style={S.feedbackBar(feedback.ok)}>
+              {feedback.ok
+                ? (feedback.bonus > 0
+                    ? `✅ Chính xác! +${CORRECT_PTS} điểm 🔥 Streak bonus +${feedback.bonus}!`
+                    : `✅ Chính xác! +${CORRECT_PTS} điểm`)
+                : `❌ Sai rồi! Đáp án đúng: "${feedback.correctWord}"`}
+            </div>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+export default MountainClimbGame;
