+  const [current, setCurrent] = useState(0);
+  const [assembled, setAssembled] = useState([]); // [{letter, id}]
+  const [available, setAvailable] = useState([]); // [{letter, id}]
+  const [score, setScore] = useState(0);
+  const [status, setStatus] = useState('loading'); // loading|playing|checking|done
+  const [feedback, setFeedback] = useState(null); // null|true|false
+  const [timerActive, setTimerActive] = useState(false);
+
+  // Fetch word pack on mount
+  useEffect(() => {
