+          <span style={S.stat}>🔄 {moves} lượt</span>
+        </div>
+      )}
+
+      {error && <p style={S.errorText}>{error}<br /><button style={S.replayBtn} onClick={initGame}>Thử lại</button></p>}
+
+      {status === 'loading' && !error && (
+        <p style={S.loadingText}>⏳ Đang tải dữ liệu...</p>
+      )}
+
+      {(status === 'playing' || status === 'done') && cards.length > 0 && (
+        <div style={S.grid}>
+          {cards.map((card) => (
+            <MemoryCard key={card.id} card={card} onClick={handleCardClick} />
+          ))}
+        </div>
+      )}
+
+      {status === 'done' && (
+        <div style={S.doneOverlay}>
+          <div style={S.doneBox}>
+            <p style={S.doneTitle}>🎉 Hoàn thành!</p>
