+function shuffleArray(arr) {
+  const a = [...arr];
+  for (let i = a.length - 1; i > 0; i--) {
+    const j = Math.floor(Math.random() * (i + 1));
+    [a[i], a[j]] = [a[j], a[i]];
+  }
+  return a;
+}
+
+function buildLetterChips(word) {
+  // Remove spaces, keep letters as-is
+  const letters = word.replace(/\s/g, '').split('');
+  const chips = letters.map((letter, idx) => ({ letter, id: `${idx}-${letter}` }));
+  return shuffleArray(chips);
+}
