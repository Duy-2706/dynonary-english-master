+    .where('studentAccountId', '==', studentAccountId)
+    .limit(1)
+    .get();
+
+  if (!enrollSnap.empty) {
+    await enrollSnap.docs[0].ref.update({
+      progressPercent,
+      completedLessons,
+      totalLessons,
+    });
+  }
+
+  return getDocById(progressCol, progressId);
+};
