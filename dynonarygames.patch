@@ -0,0 +1,243 @@
+const { db, COLLECTIONS, docToObj } = require('../configs/firebase.config');
+
+const gameRoomsCol = db.collection('gameRooms');
+
+// ─── constants ───────────────────────────────────────────────────────────────
+
+const AVATARS = ['🦁', '🐸', '🦊', '🐼', '🐯', '🦄', '🐧', '🦋', '🐳', '🦕'];
+const ANSWER_BUDGET_MS = 20000; // 20 seconds
+const BASE_SCORE = 500;
+const SPEED_BONUS_MAX = 500;
+const STREAK_THRESHOLD = 5;
+
+// ─── helpers ─────────────────────────────────────────────────────────────────
+
+function generatePin() {
+  return String(Math.floor(100000 + Math.random() * 900000));
+}
+
+function pickAvatar(existingPlayers = {}) {
+  const used = Object.values(existingPlayers).map((p) => p.avatar);
+  const available = AVATARS.filter((a) => !used.includes(a));
+  const pool = available.length > 0 ? available : AVATARS;
+  return pool[Math.floor(Math.random() * pool.length)];
+}
+
+async function getRoomByPin(pin) {
+  const snap = await gameRoomsCol.where('pin', '==', pin).limit(1).get();
+  if (snap.empty) return null;
+  return { doc: snap.docs[0], data: docToObj(snap.docs[0]) };
+}
+
+// ─── exported service functions ──────────────────────────────────────────────
+
+/**
+ * Create a new game room.
+ * @param {{ hostId, hostName, gameType, wordPack }} params
+ * @returns {{ id: string, pin: string }}
+ */
+exports.createRoom = async ({ hostId, hostName, gameType, wordPack }) => {
+  // Build questions from wordPack entries
+  const questions = (wordPack || []).map((w) => ({
+    word: w.word || '',
+    mean: w.mean || '',
+    phonetic: w.phonetic || '',
+    picture: w.picture || '',
+    audioUrl: w.audioUrl || '',
+    choices: w.choices || [],
+    correct: w.correct || w.word || '',
+  }));
+
+  // Ensure unique PIN
+  let pin = generatePin();
+  let existing = await getRoomByPin(pin);
+  while (existing) {
+    pin = generatePin();
+    existing = await getRoomByPin(pin);
+  }
+
+  const hostAvatar = AVATARS[Math.floor(Math.random() * AVATARS.length)];
+
+  const roomData = {
+    pin,
+    hostId,
+    status: 'waiting',
+    gameType: gameType || 'classic',
+    questions,
+    currentQuestion: 0,
+    questionStartAt: null,
+    players: {
+      [hostId]: {
+        name: hostName || 'Host',
+        score: 0,
+        streak: 0,
+        avatar: hostAvatar,
+        answered: false,
+      },
+    },
+    createdAt: new Date().toISOString(),
+  };
+
+  const ref = await gameRoomsCol.add(roomData);
+  return { id: ref.id, pin };
+};
+
+/**
+ * Join an existing room by PIN.
+ * @param {string} pin
+ * @param {string} userId
+ * @param {string} userName
+ * @returns {object} room data
+ */
+exports.joinRoom = async (pin, userId, userName) => {
+  const result = await getRoomByPin(pin);
+  if (!result || result.data.status !== 'waiting') {
+    throw new Error('Room not found or already started');
+  }
+
+  const { doc, data } = result;
+  const avatar = pickAvatar(data.players);
+
+  await doc.ref.update({
+    [`players.${userId}`]: {
+      name: userName || 'Player',
+      score: 0,
+      streak: 0,
+      avatar,
+      answered: false,
+    },
+  });
+
+  const updated = await doc.ref.get();
+  return docToObj(updated);
+};
+
+/**
+ * Fetch room data by PIN.
+ * @param {string} pin
+ * @returns {object|null}
+ */
+exports.getRoom = async (pin) => {
+  const result = await getRoomByPin(pin);
+  if (!result) return null;
+  return result.data;
+};
+
+/**
+ * Fetch room data by Firestore document ID.
+ * @param {string} roomId
+ * @returns {object|null}
+ */
+exports.getRoomById = async (roomId) => {
+  const doc = await gameRoomsCol.doc(roomId).get();
+  return docToObj(doc);
+};
+
+/**
+ * Start a game room (host only).
+ * @param {string} roomId
+ * @param {string} hostId
+ */
+exports.startRoom = async (roomId, hostId) => {
+  const doc = await gameRoomsCol.doc(roomId).get();
+  const data = docToObj(doc);
+
+  if (!data) throw new Error('Room not found');
+  if (data.hostId !== hostId) throw new Error('Only the host can start the room');
+
+  await doc.ref.update({
+    status: 'playing',
+    currentQuestion: 0,
+    questionStartAt: new Date().toISOString(),
+  });
+};
+
+/**
+ * Submit an answer for a question.
+ * @param {string} pin
+ * @param {string} userId
+ * @param {number} questionIndex
+ * @param {string} answer
+ * @param {number} timeMs  elapsed milliseconds since question started
+ * @returns {{ isCorrect: boolean, scoreGain: number, newScore: number }}
+ */
+exports.submitAnswer = async (pin, userId, questionIndex, answer, timeMs) => {
+  const result = await getRoomByPin(pin);
+  if (!result) throw new Error('Room not found');
+
+  const { doc, data } = result;
+  const question = data.questions[questionIndex];
+
+  if (!question) throw new Error('Question not found');
+
+  const isCorrect =
+    (answer || '').trim().toLowerCase() ===
+    (question.correct || '').trim().toLowerCase();
+
+  const player = data.players[userId] || { score: 0, streak: 0 };
+
+  let scoreGain = 0;
+  let newStreak = 0;
+
+  if (isCorrect) {
+    // Speed bonus: faster answers earn up to SPEED_BONUS_MAX extra pts
+    const elapsed = Math.max(0, Math.min(timeMs, ANSWER_BUDGET_MS));
+    const speedRatio = 1 - elapsed / ANSWER_BUDGET_MS;
+    const speedBonus = Math.round(SPEED_BONUS_MAX * speedRatio);
+
+    newStreak = (player.streak || 0) + 1;
+    const streakMultiplier = newStreak >= STREAK_THRESHOLD ? 2 : 1;
+
+    scoreGain = (BASE_SCORE + speedBonus) * streakMultiplier;
+  } else {
+    newStreak = 0;
+  }
+
+  const newScore = (player.score || 0) + scoreGain;
+
+  await doc.ref.update({
+    [`players.${userId}.score`]: newScore,
+    [`players.${userId}.streak`]: newStreak,
+    [`players.${userId}.answered`]: true,
+  });
+
+  return { isCorrect, scoreGain, newScore };
+};
+
+/**
+ * Advance to the next question (host only).
+ * @param {string} roomId
+ * @param {string} hostId
+ * @returns {{ isEnd: boolean }}
+ */
+exports.nextQuestion = async (roomId, hostId) => {
+  const doc = await gameRoomsCol.doc(roomId).get();
+  const data = docToObj(doc);
+
+  if (!data) throw new Error('Room not found');
+  if (data.hostId !== hostId) throw new Error('Only the host can advance questions');
+
+  const nextIndex = (data.currentQuestion || 0) + 1;
+  const isEnd = nextIndex >= (data.questions || []).length;
+
+  // Reset all players' answered flag
+  const playerUpdates = {};
+  for (const uid of Object.keys(data.players || {})) {
+    playerUpdates[`players.${uid}.answered`] = false;
+  }
+
+  if (isEnd) {
+    await doc.ref.update({
+      status: 'ended',
+      ...playerUpdates,
+    });
+  } else {
+    await doc.ref.update({
+      currentQuestion: nextIndex,
+      questionStartAt: new Date().toISOString(),
+      ...playerUpdates,
+    });
+  }
+
+  return { isEnd };
+};
