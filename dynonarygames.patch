+    return (
+      <div style={S.page}>
+        <div style={S.scoreCard}>
+          <div style={{ fontSize: '3rem' }}>
+            {pct >= 80 ? '🏆' : pct >= 50 ? '🌟' : '💪'}
+          </div>
+          <h2 style={{ color: '#fff', fontSize: '1.6rem', margin: '12px 0 4px' }}>
+            Hoàn thành!
+          </h2>
+          <p style={S.scoreSubtitle}>Kết quả của bạn</p>
+          <div style={S.scoreBig}>{score} điểm</div>
+          <p style={{ color: 'rgba(255,255,255,0.5)', marginBottom: '32px' }}>
+            {N_QUESTIONS} câu hỏi &nbsp;·&nbsp; Tối đa {maxScore} điểm
+          </p>
+          <Link to="/games" style={S.backLink}>
+            Chơi game khác
+          </Link>
+        </div>
+      </div>
+    );
+  }
+
+  const entry = wordPack[current];
+  if (!entry) return null;
+
+  const isChecking = status === 'checking';
+
+  return (
+    <div style={S.page}>
+      <div style={S.card}>
+        {/* Header */}
+        <div style={S.header}>
+          <h2 style={S.title}>📝 Sắp xếp chữ cái</h2>
+          <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
+            <span style={S.badge('#0f3460')}>
+              Câu {current + 1}/{wordPack.length}
+            </span>
+            <span style={S.badge('#e94560')}>⭐ {score} điểm</span>
+            <span
+              style={S.badge(
+                timeLeft > 15 ? '#26de81' : timeLeft > 8 ? '#f7b731' : '#fc5c65',
+              )}
+            >
+              ⏱ {timeLeft}s
+            </span>
+          </div>
+        </div>
+
+        {/* Timer bar */}
+        <div style={S.timerBar(timerPct)} />
+
+        {/* Hint */}
+        <div>
+          <div style={S.hintLabel}>Nghĩa</div>
+          <div style={S.hintValue}>{entry.mean}</div>
+          {entry.phonetic && (
+            <div style={S.phonetic}>{entry.phonetic}</div>
+          )}
+        </div>
+
+        {/* Assembly area */}
+        <div style={S.sectionLabel}>Đáp án:</div>
+        <div style={S.assemblyRow}>
+          {assembled.length === 0 && (
+            <span style={{ color: 'rgba(255,255,255,0.2)', fontSize: '0.9rem' }}>
+              Nhấn chữ bên dưới để ghép...
+            </span>
+          )}
+          {assembled.map((chip) => (
+            <button
+              key={chip.id}
+              style={S.assembledChip}
+              onClick={() => handleReturnLetter(chip)}
+              disabled={isChecking}
+            >
+              {chip.letter}
+            </button>
+          ))}
+        </div>
+
+        {/* Available letters */}
+        <div style={S.sectionLabel}>Chọn chữ cái:</div>
+        <div style={S.availableRow}>
+          {available.map((chip) => {
+            const used = assembled.some((c) => c.id === chip.id);
+            return (
+              <button
+                key={chip.id}
+                style={S.availableChip(used || isChecking)}
+                onClick={() => handlePickLetter(chip)}
+                disabled={used || isChecking}
+              >
+                {chip.letter}
+              </button>
+            );
+          })}
+        </div>
+
+        {/* Buttons */}
+        <div style={S.buttonRow}>
+          <button
+            style={S.btn('rgba(255,255,255,0.1)')}
+            onClick={handleClear}
+            disabled={isChecking}
+          >
+            Xóa
+          </button>
+          <button
+            style={S.btn('rgba(255,255,255,0.07)', 'rgba(255,255,255,0.45)')}
+            onClick={handleSkip}
+            disabled={isChecking}
+          >
+            Bỏ qua
+          </button>
+          <button
+            style={S.btn('#e94560')}
+            onClick={() => handleCheck(false)}
+            disabled={isChecking || assembled.length === 0}
+          >
+            Kiểm tra
+          </button>
+        </div>
+
+        {/* Feedback */}
+        {feedback !== null && (
+          <div style={S.feedback(feedback)}>
+            {feedback
+              ? `✅ Chính xác! +${100 + Math.round((timeLeft / TIMER_SECONDS) * 50)} điểm`
+              : `❌ Sai rồi! Đáp án: ${entry.word}`}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
+
+// ---------------------------------------------------------------------------
+// Page wrapper (matches existing page pattern)
+// ---------------------------------------------------------------------------
+
+function WordOrderPage() {
+  useTitle('Sắp xếp chữ cái (Word Order)');
+  useCloseNavigation();
+  return <WordOrderGame />;
+}
+
+export default WordOrderPage;
