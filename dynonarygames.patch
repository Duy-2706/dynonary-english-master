+  // ── Apply filters ────────────────────────────────────────────────────────
+  let list = WORD_LIST;
+
+  if (FILTER_TOPIC) {
+    list = list.filter((w) => w.topics.includes(FILTER_TOPIC));
+    if (list.length === 0) {
+      console.error(`No words found for topic "${FILTER_TOPIC}".`);
+      console.error('Available topics: ' + [...new Set(WORD_LIST.flatMap((w) => w.topics))].sort().join(', '));
+      process.exit(1);
+    }
+  }
+
+  if (FILTER_LEVEL) {
+    list = list.filter((w) => w.level === FILTER_LEVEL);
+    if (list.length === 0) {
+      console.error(`No words found for level "${FILTER_LEVEL}".`);
+      console.error('Available levels: A1, A2, B1, B2, C1, C2');
+      process.exit(1);
+    }
+  }
+
+  console.log(`Processing ${list.length} word(s) ...\n`);
+
+  // ── Process words sequentially (rate-limiting-friendly) ──────────────────
+  for (let i = 0; i < list.length; i++) {
+    await processWord(list[i], i + 1, list.length);
+  }
+
+  // ── Summary ──────────────────────────────────────────────────────────────
+  console.log('\n' + '─'.repeat(60));
+  console.log('Summary:');
+  console.log(`  Total processed : ${stats.total}`);
+  console.log(`  Created         : ${stats.created}`);
+  console.log(`  Updated         : ${stats.updated}`);
+  console.log(`  Skipped         : ${stats.skipped}`);
+  console.log(`  Failed          : ${stats.failed}`);
+  console.log('='.repeat(60));
+
+  if (!DRY_RUN) {
+    // Allow Firestore to flush pending writes before exiting.
+    await sleep(1000);
+  }
+  process.exit(stats.failed > 0 ? 1 : 0);
+}
+
+main().catch((err) => {
+  console.error('Fatal error:', err);
+  process.exit(1);
+});
