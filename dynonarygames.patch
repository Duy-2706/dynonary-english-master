+
+  return (
+    <div style={S.root}>
+      <style>{BALL_ANIMATION_CSS}</style>
+
+      <h1 style={S.title}>🏀 Ném bóng từ vựng</h1>
+
+      {/* Stats */}
+      <div style={S.statsRow}>
+        <span style={S.stat}>Câu {current + 1}/{wordPack.length}</span>
+        <span style={{ ...S.stat, color: '#ffd54f' }}>⭐ {score} điểm</span>
+        <span style={{
+          ...S.stat,
+          color: timer > 5 ? '#2ecc71' : timer > 3 ? '#f39c12' : '#e74c3c',
+        }}>
+          ⏱ {timer}s
+        </span>
+      </div>
+
+      {/* Court area with hoop and ball */}
+      <div style={S.courtArea}>
+        {/* Hoop */}
+        <div style={S.hoopContainer}>
+          <span
+            className={hoopShaking ? 'bb-hoop-shake' : ''}
+            style={S.hoopEmoji}
+          >
+            🥅
+          </span>
+          <div style={S.hoopPost} />
+        </div>
+
+        {/* Floor line */}
+        <div style={S.floorLine} />
+
+        {/* Static ball (hidden when flying) */}
+        {!showBall && (
+          <div style={{ ...S.staticBall, opacity: isAnswered && !isCorrectAnswer ? 0.4 : 1 }}>
+            🏀
+          </div>
+        )}
+
+        {/* Flying ball animation */}
+        {showBall && (
+          <span className="bb-ball-fly">🏀</span>
+        )}
+
+        {/* Score pop on correct */}
+        {scorePopText && (
+          <div className="bb-score-pop" style={S.scorePop}>{scorePopText}</div>
+        )}
+      </div>
+
+      {/* Timer bar */}
+      <div style={S.timerBarWrap}>
+        <div style={S.timerBar(timerPct)} />
+      </div>
+
+      {/* Question */}
+      <div style={S.questionBox}>
+        <div style={S.questionLabel}>Từ nào có nghĩa là:</div>
+        <div style={S.questionText}>"{item.mean}"</div>
+        {item.phonetic && (
+          <div style={{ color: '#f39c12', marginTop: '6px', fontSize: '0.9rem' }}>
+            {item.phonetic}
+          </div>
+        )}
+      </div>
+
+      {/* Choices */}
+      <div style={S.choicesGrid}>
+        {choices.map((choice, idx) => {
+          const state = getChoiceState(choice);
+          return (
+            <button
+              key={idx}
+              style={S.choiceBtn(CHOICE_COLORS[idx % 4], state)}
+              onClick={() => handleAnswer(choice)}
+              disabled={isAnswered}
+            >
+              {choice}
+            </button>
+          );
+        })}
+      </div>
+
+      {/* Feedback banner */}
+      {isAnswered && selectedAnswer !== '__timeout__' && (
+        <div style={S.feedbackBanner(isCorrectAnswer)}>
+          {isCorrectAnswer
+            ? `✅ Chính xác! Thêm ${scorePopText}`
+            : `❌ Sai! Đáp án đúng: "${item.word}"`}
+        </div>
+      )}
+      {isAnswered && selectedAnswer === '__timeout__' && (
+        <div style={S.feedbackBanner(false)}>
+          ⏰ Hết giờ! Đáp án đúng: "{item.word}"
+        </div>
+      )}
+    </div>
+  );
+}
+
+export default BasketballQuizGame;
