+      const chips = buildLetterChips(entry.word);
+      setAvailable(chips);
+      setAssembled([]);
+      setFeedback(null);
+      setTimerActive(true);
+      setStatus('playing');
+    },
+    [wordPack],
+  );
+
+  // When wordPack loads, load first question
