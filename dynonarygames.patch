+/* ─── Card Component ─────────────────────────────────────────── */
+function MemoryCard({ card, onClick }) {
+  const isVisible = card.flipped || card.matched;
+  const innerClass = `mm-card-inner${isVisible ? ' flipped' : ''}${card.matched ? ' mm-matched' : ''}`;
