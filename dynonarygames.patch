+import React, { useState, useEffect, useCallback, useRef } from 'react';
+import gameApi from 'apis/gameApi';
+
+const SPIN_CSS = `
+  @keyframes lc-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
+  @keyframes lc-pulse {
+    0%,100% { transform: scale(1); opacity: 1; }
+    50%      { transform: scale(1.15); opacity: 0.8; }
+  }
+  @keyframes lc-pop {
+    0%   { transform: scale(0.8); opacity: 0; }
+    70%  { transform: scale(1.1); opacity: 1; }
+    100% { transform: scale(1); opacity: 1; }
+  }
+  .lc-spinner { animation: lc-spin 0.9s linear infinite; }
+  .lc-sound-pulse { animation: lc-pulse 1.2s ease infinite; }
+  .lc-pop { animation: lc-pop 0.35s ease forwards; }
+`;
+
+const N_QUESTIONS = 20;
+const AUTO_ADVANCE_MS = 1800;
+
+function buildQuestionSet(wordPack, correctItem) {
+  const wrong = wordPack
+    .filter((w) => w.word !== correctItem.word)
+    .sort(() => Math.random() - 0.5)
+    .slice(0, 3);
+  const all = [...wrong, correctItem].sort(() => Math.random() - 0.5);
+  return all.map((w) => ({
+    word: w.word,
+    picture: w.picture || '',
+    audioUrl: w.audioUrl || `https://translate.google.com/translate_tts?ie=UTF-8&tl=en&client=tw-ob&q=${encodeURIComponent(w.word)}`,
+    isCorrect: w.word === correctItem.word,
+  }));
+}
+
+function ListenChoosePage() {
+  const [status, setStatus] = useState('loading'); // loading | playing | done
+  const [wordPack, setWordPack] = useState([]);
+  const [current, setCurrent] = useState(0);
+  const [questionSet, setQuestionSet] = useState([]);
+  const [score, setScore] = useState(0);
+  const [selectedIndex, setSelectedIndex] = useState(null);
+  const [answered, setAnswered] = useState(false);
+  const [hovered, setHovered] = useState(null);
+  const audioRef = useRef(null);
+
+  useEffect(() => {
+    (async () => {
+      try {
+        const res = await gameApi.getWordPackFG();
+        const pack = (res.data?.wordPack || []).filter((w) => w.picture);
+        if (pack.length < 4) {
+          setStatus('done');
+          return;
+        }
+        setWordPack(pack);
+        const shuffled = pack.sort(() => Math.random() - 0.5);
+        loadQuestion(shuffled, 0, pack);
+      } catch {
+        setStatus('done');
+      }
+    })();
+  }, []);
+
+  const playAudio = useCallback((url) => {
+    try {
+      if (audioRef.current) audioRef.current.pause();
+      const a = new Audio(url);
+      audioRef.current = a;
+      a.play().catch(() => {});
+    } catch {}
+  }, []);
+
+  function loadQuestion(shuffledPack, index, pack) {
+    const questions = shuffledPack.slice(0, N_QUESTIONS);
+    const correctItem = questions[index];
+    const pool = pack || shuffledPack;
+    const qSet = buildQuestionSet(pool, correctItem);
+    setQuestionSet(qSet);
+    setSelectedIndex(null);
+    setAnswered(false);
+    setCurrent(index);
+    setStatus('playing');
+    setTimeout(() => playAudio(correctItem.audioUrl), 400);
+  }
+
+  const handleSelect = (idx) => {
+    if (answered) return;
+    setSelectedIndex(idx);
+    setAnswered(true);
+    const isCorrect = questionSet[idx].isCorrect;
+    if (isCorrect) setScore((s) => s + 200);
+
+    const questions = wordPack.sort(() => Math.random() - 0.5).slice(0, N_QUESTIONS);
+    setTimeout(() => {
+      const next = current + 1;
+      if (next >= N_QUESTIONS || next >= questions.length) {
+        setStatus('done');
+      } else {
+        const pool = wordPack;
+        const correctItem = questions[next];
+        const qSet = buildQuestionSet(pool, correctItem);
+        setQuestionSet(qSet);
+        setSelectedIndex(null);
+        setAnswered(false);
+        setCurrent(next);
+        setTimeout(() => playAudio(correctItem.audioUrl), 300);
+      }
+    }, AUTO_ADVANCE_MS);
+  };
+
+  const handleReplay = () => {
+    setScore(0);
+    setCurrent(0);
+    setSelectedIndex(null);
+    setAnswered(false);
+    setStatus('loading');
+    const shuffled = [...wordPack].sort(() => Math.random() - 0.5);
+    loadQuestion(shuffled, 0, wordPack);
+  };
+
+  const correctWord = questionSet.find((q) => q.isCorrect);
+
+  const getCardStyle = (idx) => {
+    const base = {
+      borderRadius: 16,
+      overflow: 'hidden',
+      cursor: answered ? 'default' : 'pointer',
+      border: '3px solid transparent',
+      transition: 'all 0.25s ease',
+      background: '#16213e',
+      boxShadow: '0 4px 16px rgba(0,0,0,0.4)',
+      transform: hovered === idx && !answered ? 'scale(1.04)' : 'scale(1)',
+    };
+    if (answered) {
+      if (questionSet[idx]?.isCorrect) {
+        return { ...base, border: '3px solid #00b894', boxShadow: '0 0 20px rgba(0,184,148,0.5)' };
+      }
+      if (idx === selectedIndex) {
+        return { ...base, border: '3px solid #e17055', boxShadow: '0 0 20px rgba(225,112,85,0.5)', opacity: 0.7 };
+      }
+    }
+    if (hovered === idx && !answered) {
+      return { ...base, border: '3px solid #a55eea', boxShadow: '0 0 20px rgba(165,94,234,0.4)' };
+    }
+    return base;
+  };
+
+  if (status === 'loading') {
+    return (
+      <div style={{ minHeight: '100vh', background: '#1a1a2e', display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center' }}>
+        <style>{SPIN_CSS}</style>
+        <div className="lc-spinner" style={{ width: 52, height: 52, border: '5px solid rgba(165,94,234,0.3)', borderTopColor: '#a55eea', borderRadius: '50%', marginBottom: 16 }} />
+        <p style={{ color: '#a55eea', fontSize: '1.2rem' }}>Đang tải bài chơi...</p>
+      </div>
+    );
+  }
+
+  if (status === 'done') {
+    const maxScore = N_QUESTIONS * 200;
+    const pct = Math.round((score / maxScore) * 100);
+    return (
+      <div style={{ minHeight: '100vh', background: '#1a1a2e', display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', padding: 24 }}>
+        <style>{SPIN_CSS}</style>
+        <div style={{ background: '#16213e', borderRadius: 24, padding: '48px 40px', textAlign: 'center', maxWidth: 480, width: '100%', border: '1px solid rgba(165,94,234,0.4)', boxShadow: '0 20px 60px rgba(0,0,0,0.5)' }}>
+          <div style={{ fontSize: '4rem', marginBottom: 16 }}>
+            {pct >= 80 ? '🏆' : pct >= 50 ? '⭐' : '💪'}
+          </div>
+          <h2 style={{ color: '#ffffff', fontSize: '2rem', margin: '0 0 8px', fontWeight: 900 }}>Hoàn thành!</h2>
+          <p style={{ color: 'rgba(255,255,255,0.7)', marginBottom: 24, fontSize: '1rem' }}>
+            Bạn đã nghe và chọn chính xác {Math.round(pct / 100 * N_QUESTIONS)}/{N_QUESTIONS} từ
+          </p>
+          <div style={{ background: 'linear-gradient(135deg, #a55eea, #7c4dff)', borderRadius: 16, padding: '20px 32px', marginBottom: 32, display: 'inline-block' }}>
+            <span style={{ color: '#fff', fontSize: '2.8rem', fontWeight: 900 }}>⭐ {score}</span>
+            <span style={{ color: 'rgba(255,255,255,0.7)', fontSize: '1rem', display: 'block' }}>điểm</span>
+          </div>
+          <div style={{ display: 'flex', gap: 16, justifyContent: 'center' }}>
+            <button onClick={handleReplay} style={{ padding: '12px 32px', borderRadius: 12, border: 'none', background: 'linear-gradient(135deg, #a55eea, #7c4dff)', color: '#fff', fontSize: '1rem', fontWeight: 700, cursor: 'pointer' }}>
+              🔄 Chơi lại
+            </button>
+            <button onClick={() => window.history.back()} style={{ padding: '12px 32px', borderRadius: 12, border: '2px solid rgba(255,255,255,0.2)', background: 'transparent', color: '#fff', fontSize: '1rem', fontWeight: 700, cursor: 'pointer' }}>
+              ← Quay lại
+            </button>
+          </div>
+        </div>
+      </div>
+    );
+  }
+
+  const questions = wordPack.sort(() => 0).slice(0, N_QUESTIONS);
+
+  return (
+    <div style={{ minHeight: '100vh', background: '#1a1a2e', padding: '24px 16px 48px', boxSizing: 'border-box' }}>
+      <style>{SPIN_CSS}</style>
+      <div style={{ maxWidth: 700, margin: '0 auto' }}>
+        {/* Header */}
+        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 24, background: '#16213e', borderRadius: 16, padding: '16px 24px', border: '1px solid rgba(165,94,234,0.3)' }}>
+          <div>
+            <h1 style={{ color: '#ffffff', fontSize: '1.4rem', fontWeight: 900, margin: 0 }}>🔊 Nghe và chọn</h1>
+            <p style={{ color: 'rgba(255,255,255,0.5)', margin: 0, fontSize: '0.85rem' }}>
+              Câu {current + 1}/{Math.min(N_QUESTIONS, questions.length)}
+            </p>
+          </div>
+          <div style={{ textAlign: 'right' }}>
+            <div style={{ color: '#f7b731', fontWeight: 900, fontSize: '1.6rem' }}>⭐ {score}</div>
+          </div>
+        </div>
+
+        {/* Audio section */}
+        <div style={{ textAlign: 'center', marginBottom: 28 }}>
+          <p style={{ color: 'rgba(255,255,255,0.6)', marginBottom: 12, fontSize: '0.95rem' }}>
+            Nghe từ và chọn hình ảnh đúng
+          </p>
+          <button
+            className="lc-sound-pulse"
+            onClick={() => correctWord && playAudio(correctWord.audioUrl)}
+            style={{ width: 80, height: 80, borderRadius: '50%', border: 'none', background: 'linear-gradient(135deg, #a55eea, #7c4dff)', color: '#fff', fontSize: '2.4rem', cursor: 'pointer', boxShadow: '0 8px 24px rgba(165,94,234,0.5)' }}
+          >
+            🔊
+          </button>
+          <p style={{ color: 'rgba(255,255,255,0.4)', fontSize: '0.8rem', marginTop: 8 }}>Nhấn để nghe lại</p>
+        </div>
+
+        {/* Image grid */}
+        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>
+          {questionSet.map((item, idx) => (
+            <div
+              key={idx}
+              className={answered ? 'lc-pop' : ''}
+              style={getCardStyle(idx)}
+              onClick={() => handleSelect(idx)}
+              onMouseEnter={() => !answered && setHovered(idx)}
+              onMouseLeave={() => setHovered(null)}
+            >
+              {item.picture ? (
+                <img
+                  src={item.picture}
+                  alt=""
+                  style={{ width: '100%', height: 180, objectFit: 'cover', display: 'block' }}
+                  onError={(e) => { e.target.style.display = 'none'; }}
+                />
+              ) : (
+                <div style={{ width: '100%', height: 180, background: `hsl(${idx * 90}, 60%, 25%)`, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
+                  <span style={{ color: '#fff', fontSize: '1.1rem', fontWeight: 700, textAlign: 'center', padding: 8 }}>{item.word}</span>
+                </div>
+              )}
+              {answered && item.isCorrect && (
+                <div style={{ position: 'absolute', top: 8, right: 8, background: '#00b894', borderRadius: '50%', width: 28, height: 28, display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#fff', fontWeight: 900, fontSize: '1rem' }}>✓</div>
+              )}
+              {answered && idx === selectedIndex && !item.isCorrect && (
+                <div style={{ position: 'absolute', top: 8, right: 8, background: '#e17055', borderRadius: '50%', width: 28, height: 28, display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#fff', fontWeight: 900, fontSize: '1rem' }}>✗</div>
+              )}
+            </div>
+          ))}
+        </div>
+
+        {/* Feedback */}
+        {answered && (
+          <div style={{ textAlign: 'center', marginTop: 20, padding: '12px 24px', borderRadius: 12, background: questionSet[selectedIndex]?.isCorrect ? 'rgba(0,184,148,0.15)' : 'rgba(225,112,85,0.15)', border: `1px solid ${questionSet[selectedIndex]?.isCorrect ? '#00b894' : '#e17055'}` }}>
+            <span style={{ color: questionSet[selectedIndex]?.isCorrect ? '#00b894' : '#e17055', fontWeight: 700, fontSize: '1.1rem' }}>
+              {questionSet[selectedIndex]?.isCorrect ? '✅ Chính xác! +200 điểm' : `❌ Sai! Đáp án đúng: "${correctWord?.word}"`}
+            </span>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
+
+export default ListenChoosePage;
