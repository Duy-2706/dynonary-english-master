+      const isCorrect = !timedOut && attempt.toLowerCase() === target.toLowerCase();
+
+      setFeedback(isCorrect);
+
+      if (isCorrect) {
+        const speedBonus = Math.round((timeLeft / TIMER_SECONDS) * 50);
+        setScore((s) => s + 100 + speedBonus);
+      }
+
+      setTimeout(() => {
+        const next = current + 1;
+        if (next >= wordPack.length) {
+          setStatus('done');
+        } else {
+          setCurrent(next);
+          const chips = buildLetterChips(wordPack[next].word);
+          setAvailable(chips);
+          setAssembled([]);
+          setFeedback(null);
+          setTimerActive(true);
+          setStatus('playing');
