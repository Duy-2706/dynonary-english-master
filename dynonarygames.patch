+    setStatus('loading');
+    setError(null);
+    setCurrent(0);
+    setScore(0);
+    setSelectedAnswer(null);
+    setShowBall(false);
+    setScorePopText(null);
+    try {
+      const res = await gameApi.getWordPackCWG(
+        undefined, undefined, undefined, [], N_QUESTIONS,
