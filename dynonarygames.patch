+// ─── Utility helpers ──────────────────────────────────────────────────────────
+
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+// ─── Firestore helpers ────────────────────────────────────────────────────────
+
+/**
+ * Check whether a sentence already exists by matching the `sentence` field.
+ * Returns the document ID if found, otherwise null.
+ */
+async function findExistingSentenceId(sentence) {
+  const snap = await db
+    .collection(COLLECTIONS.SENTENCES)
+    .where('sentence', '==', sentence)
+    .limit(1)
+    .get();
+  return snap.empty ? null : snap.docs[0].id;
+}
+
+// ─── Statistics ───────────────────────────────────────────────────────────────
+
+const stats = { total: 0, created: 0, updated: 0, skipped: 0, failed: 0 };
+
+// ─── Main ─────────────────────────────────────────────────────────────────────
+
+async function main() {
+  console.log('='.repeat(60));
+  console.log(' seedSentences.js – Dynonary sentence seeder');
+  console.log('='.repeat(60));
+  console.log(`Mode    : ${DRY_RUN ? 'DRY-RUN (no writes)' : 'LIVE'}`);
+  console.log(`Force   : ${FORCE}`);
+  console.log(`Topic   : ${FILTER_TOPIC || 'all'}`);
+  console.log(`Level   : ${FILTER_LEVEL || 'all'}`);
+  console.log('─'.repeat(60));
+
+  // ── Apply filters ────────────────────────────────────────────────────────
+  let list = SENTENCE_LIST;
+
+  if (FILTER_TOPIC) {
+    list = list.filter((s) => s.topics.includes(FILTER_TOPIC));
+    if (list.length === 0) {
+      const available = [...new Set(SENTENCE_LIST.flatMap((s) => s.topics))].sort();
+      console.error(`No sentences found for topic "${FILTER_TOPIC}".`);
+      console.error('Available topics: ' + available.join(', '));
+      process.exit(1);
+    }
+  }
+
+  if (FILTER_LEVEL) {
+    list = list.filter((s) => s.level === FILTER_LEVEL);
+    if (list.length === 0) {
+      console.error(`No sentences found for level "${FILTER_LEVEL}".`);
+      console.error('Available levels: A1, A2, B1, B2');
+      process.exit(1);
+    }
+  }
+
+  console.log(`Processing ${list.length} sentence(s) ...\n`);
+
+  if (DRY_RUN) {
+    // Print all and exit
+    for (let i = 0; i < list.length; i++) {
+      const s = list[i];
+      const { _key, level, topics, ...doc } = s;
+      process.stdout.write(
+        `✅ [${i + 1}/${list.length}] DRY-RUN (${level}, ${topics.join(', ')})\n` +
+          `   "${s.sentence}"\n`,
+      );
+      stats.total++;
+      stats.created++;
+    }
+  } else {
+    // ── Batch-write to Firestore ──────────────────────────────────────────
+    // We process in BATCH_SIZE chunks; within each chunk we first check for
+    // duplicates (cannot be done inside a commit batch) then write.
+    for (let chunkStart = 0; chunkStart < list.length; chunkStart += BATCH_SIZE) {
+      const chunk = list.slice(chunkStart, chunkStart + BATCH_SIZE);
+      const batch = db.batch();
+      let batchCount = 0;
+
+      for (let j = 0; j < chunk.length; j++) {
+        const s = chunk[j];
+        const globalIdx = chunkStart + j + 1;
+        stats.total++;
+
+        try {
+          const existingId = await findExistingSentenceId(s.sentence);
+
+          if (existingId && !FORCE) {
+            process.stdout.write(`⚠️  [${globalIdx}/${list.length}] Skipped (exists): "${s.sentence.slice(0, 60)}"\n`);
+            stats.skipped++;
+            continue;
+          }
+
+          // Build clean doc (omit internal fields)
+          const { _key, level, ...rest } = s;
+          const doc = { ...rest, level, isChecked: false };
+
+          if (existingId) {
+            batch.update(db.collection(COLLECTIONS.SENTENCES).doc(existingId), doc);
+            process.stdout.write(`✅ [${globalIdx}/${list.length}] Updated : "${s.sentence.slice(0, 60)}"\n`);
+            stats.updated++;
+          } else {
+            batch.set(db.collection(COLLECTIONS.SENTENCES).doc(), doc);
+            process.stdout.write(`✅ [${globalIdx}/${list.length}] Created : "${s.sentence.slice(0, 60)}"\n`);
+            stats.created++;
+          }
+          batchCount++;
+        } catch (err) {
+          process.stderr.write(
+            `❌ [${globalIdx}/${list.length}] Failed : "${s.sentence.slice(0, 60)}": ${err.message}\n`,
+          );
+          stats.failed++;
+        }
+      }
+
+      if (batchCount > 0) {
+        try {
+          await batch.commit();
+        } catch (err) {
+          process.stderr.write(`❌ Batch commit failed: ${err.message}\n`);
+          // Attribute all in this batch to failed
+          stats.failed   += batchCount;
+          stats.created  -= chunk.filter((_, j) => {
+            const idx = chunkStart + j;
+            return idx < chunkStart + batchCount;
+          }).length;
+        }
+      }
+    }
+  }
+
+  // ── Summary ──────────────────────────────────────────────────────────────
+  console.log('\n' + '─'.repeat(60));
+  console.log('Summary:');
+  console.log(`  Total processed : ${stats.total}`);
+  console.log(`  Created         : ${stats.created}`);
+  console.log(`  Updated         : ${stats.updated}`);
+  console.log(`  Skipped         : ${stats.skipped}`);
+  console.log(`  Failed          : ${stats.failed}`);
+  console.log('='.repeat(60));
+
+  if (!DRY_RUN) {
+    await sleep(500);
+  }
+  process.exit(stats.failed > 0 ? 1 : 0);
+}
+
+main().catch((err) => {
+  console.error('Fatal error:', err);
+  process.exit(1);
+});
