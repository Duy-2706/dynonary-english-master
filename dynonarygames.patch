+              onMouseOut={(e) => (e.currentTarget.style.transform = 'scale(1)')}
+              onClick={initGame}
+            >
+              Chơi lại
+            </button>
+          </div>
+        </div>
+      </div>
+    );
+  }
+
+  const item = wordPack[current];
+  if (!item) return null;
+
+  const timerPct = (timer / TIMER_SECONDS) * 100;
+  const isAnswered = status === 'animating';
