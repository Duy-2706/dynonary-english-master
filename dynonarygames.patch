--- /dev/null
+++ b/backend/scripts/migrateFromMongo.js
@@ -0,0 +1,218 @@
+/**
+ * migrateFromMongo.js
+ * ─────────────────────────────────────────────────────────────────────────────
+ * Chuyển dữ liệu từ MongoDB JSON export sang Firestore.
+ *
+ * Cách dùng:
+ *   1. Export từng collection từ MongoDB:
+ *        mongoexport --db dynonary --collection words --out exports/words.json
+ *        mongoexport --db dynonary --collection sentences --out exports/sentences.json
+ *        mongoexport --db dynonary --collection blogs --out exports/blogs.json
+ *        mongoexport --db dynonary --collection accounts --out exports/accounts.json
+ *        mongoexport --db dynonary --collection users --out exports/users.json
+ *        mongoexport --db dynonary --collection highscores --out exports/highscores.json
+ *        mongoexport --db dynonary --collection courses --out exports/courses.json
+ *        mongoexport --db dynonary --collection chapters --out exports/chapters.json
+ *        mongoexport --db dynonary --collection lessons --out exports/lessons.json
+ *        mongoexport --db dynonary --collection enrollments --out exports/enrollments.json
+ *        mongoexport --db dynonary --collection lessonProgress --out exports/lessonProgress.json
+ *        mongoexport --db dynonary --collection classrooms --out exports/classrooms.json
+ *
+ *   2. Đặt các file .json vào thư mục backend/exports/
+ *
+ *   3. Chạy:
+ *        cd backend
+ *        node scripts/migrateFromMongo.js
+ *
+ *   Hoặc chỉ migrate 1 collection:
+ *        node scripts/migrateFromMongo.js --collection words
+ * ─────────────────────────────────────────────────────────────────────────────
+ */
+
+require('dotenv').config({ path: require('path').join(__dirname, '../.local.env') });
+require('dotenv').config({ path: require('path').join(__dirname, '../.env') });
+
+const fs = require('fs');
+const path = require('path');
+const { db, COLLECTIONS } = require('../src/configs/firebase.config');
+
+const EXPORTS_DIR = path.join(__dirname, '../exports');
+const BATCH_SIZE = 400; // Firestore batch limit = 500; dùng 400 cho an toàn
+
+// Mapping: tên file export → collection Firestore
+const COLLECTION_MAP = {
+  accounts: COLLECTIONS.ACCOUNTS,
+  users: COLLECTIONS.USERS,
+  verifyCodes: COLLECTIONS.VERIFY_CODES,
+  words: COLLECTIONS.WORDS,
+  sentences: COLLECTIONS.SENTENCES,
+  blogs: COLLECTIONS.BLOGS,
+  highscores: COLLECTIONS.HIGHSCORES,
+  courses: COLLECTIONS.COURSES,
+  chapters: COLLECTIONS.CHAPTERS,
+  lessons: COLLECTIONS.LESSONS,
+  enrollments: COLLECTIONS.ENROLLMENTS,
+  lessonProgress: COLLECTIONS.LESSON_PROGRESS,
+  classrooms: COLLECTIONS.CLASSROOMS,
+};
+
+// ─── helpers ─────────────────────────────────────────────────────────────────
+
+/**
+ * Chuyển đổi document MongoDB sang Firestore-friendly object.
+ * - Xoá __v
+ * - Chuyển $oid → string
+ * - Chuyển $date → Date object
+ * - Chuyển $numberLong, $numberInt → number
+ */
+function transformDoc(doc) {
+  if (doc === null || doc === undefined) return doc;
+
+  // MongoDB extended JSON — $oid
+  if (doc.$oid) return doc.$oid;
+
+  // $date
+  if (doc.$date) {
+    const val = doc.$date;
+    if (typeof val === 'string') return new Date(val);
+    if (val.$numberLong) return new Date(parseInt(val.$numberLong));
+    return new Date(val);
+  }
+
+  // $numberLong, $numberInt, $numberDouble
+  if (doc.$numberLong !== undefined) return parseInt(doc.$numberLong);
+  if (doc.$numberInt !== undefined) return parseInt(doc.$numberInt);
+  if (doc.$numberDouble !== undefined) return parseFloat(doc.$numberDouble);
+
+  // Array
+  if (Array.isArray(doc)) return doc.map(transformDoc);
+
+  // Object
+  if (typeof doc === 'object') {
+    const result = {};
+    for (const [key, val] of Object.entries(doc)) {
+      if (key === '__v') continue; // bỏ version key của Mongoose
+      if (key === '_id') continue; // bỏ _id — Firestore tự tạo ID mới
+      result[key] = transformDoc(val);
+    }
+    return result;
+  }
+
+  return doc;
+}
+
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+/**
+ * Đọc file JSON export của MongoDB.
+ * mongoexport tạo ra NDJSON (mỗi dòng là 1 JSON object), không phải JSON array.
+ */
+function readNdjson(filePath) {
+  const raw = fs.readFileSync(filePath, 'utf8');
+  return raw
+    .split('\n')
+    .filter((line) => line.trim())
+    .map((line) => JSON.parse(line));
+}
+
+async function migrateCollection(collectionName, targetCollection) {
+  const filePath = path.join(EXPORTS_DIR, `${collectionName}.json`);
+
+  if (!fs.existsSync(filePath)) {
+    console.log(`  ⏭  ${collectionName}: file không tồn tại, bỏ qua`);
+    return 0;
+  }
+
+  const docs = readNdjson(filePath);
+  if (docs.length === 0) {
+    console.log(`  ⏭  ${collectionName}: không có dữ liệu`);
+    return 0;
+  }
+
+  const colRef = db.collection(targetCollection);
+  let imported = 0;
+
+  // Chia thành các batch 400 documents
+  for (let i = 0; i < docs.length; i += BATCH_SIZE) {
+    const chunk = docs.slice(i, i + BATCH_SIZE);
+    const batch = db.batch();
+
+    for (const raw of chunk) {
+      const transformed = transformDoc(raw);
+
+      // Thêm words collection đặc biệt: word phải lowercase
+      if (targetCollection === COLLECTIONS.WORDS && transformed.word) {
+        transformed.word = transformed.word.toLowerCase();
+      }
+
+      const docRef = colRef.doc(); // Firestore tự tạo ID mới
+      batch.set(docRef, transformed);
+    }
+
+    await batch.commit();
+    imported += chunk.length;
+
+    process.stdout.write(
+      `\r  ✅ ${collectionName}: ${imported}/${docs.length} documents`,
+    );
+
+    // Rate limiting — tránh bị Firestore throttle
+    if (i + BATCH_SIZE < docs.length) await sleep(500);
+  }
+
+  console.log(
+    `\r  ✅ ${collectionName}: ${imported} documents đã import       `,
+  );
+  return imported;
+}
+
+// ─── main ─────────────────────────────────────────────────────────────────────
+
+async function main() {
+  const targetArg = process.argv.find((a, i) => process.argv[i - 1] === '--collection');
+
+  console.log('🔥 Dynonary — MongoDB → Firestore Migration Script');
+  console.log('═'.repeat(50));
+
+  if (!fs.existsSync(EXPORTS_DIR)) {
+    console.error(`\n❌ Thư mục exports không tồn tại: ${EXPORTS_DIR}`);
+    console.error('  → Tạo thư mục backend/exports/ và đặt các file JSON vào đó');
+    process.exit(1);
+  }
+
+  const collections = targetArg
+    ? { [targetArg]: COLLECTION_MAP[targetArg] }
+    : COLLECTION_MAP;
+
+  if (targetArg && !COLLECTION_MAP[targetArg]) {
+    console.error(`\n❌ Collection không hợp lệ: ${targetArg}`);
+    console.error('  Các collection hợp lệ:', Object.keys(COLLECTION_MAP).join(', '));
+    process.exit(1);
+  }
+
+  console.log(`\n📦 Bắt đầu import ${Object.keys(collections).length} collections:\n`);
+
+  let total = 0;
+  const start = Date.now();
+
+  for (const [name, fsCollection] of Object.entries(collections)) {
+    total += await migrateCollection(name, fsCollection);
+  }
+
+  const elapsed = ((Date.now() - start) / 1000).toFixed(1);
+  console.log('\n' + '═'.repeat(50));
+  console.log(`✅ Migration hoàn tất! ${total} documents trong ${elapsed}s`);
+  console.log('\n📋 Lưu ý:');
+  console.log('  • MongoDB _id đã bị bỏ → Firestore tạo ID mới');
+  console.log('  • Cần cập nhật các reference (courseId, chapterId...) nếu dùng data cũ');
+  console.log('  • Kiểm tra lại Firebase Console để xác nhận data\n');
+
+  process.exit(0);
+}
+
+main().catch((err) => {
+  console.error('\n❌ Lỗi:', err);
+  process.exit(1);
+});
