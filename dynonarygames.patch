+        const pack = (res?.data?.wordPack || []).slice(0, N_QUESTIONS);
+        setWordPack(pack);
+        setStatus('playing');
+      })
+      .catch(() => setStatus('error'));
+  }, []);
+
+  // Load a question from wordPack[current]
+  const loadQuestion = useCallback(
+    (idx, pack) => {
+      const src = pack || wordPack;
+      const entry = src[idx];
+      if (!entry) {
+        setStatus('done');
+        return;
