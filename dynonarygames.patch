+/**
+ * Given a word string, decide which letter indices to blank out.
+ * Returns { blankedWord: [{letter, blanked}], blankedLetters: string }
+ */
+function buildBlankedWord(word) {
+  // Work only on alphabetic chars; keep other chars (hyphens etc.) visible
+  const letters = word.split('');
+  const alphaIndices = letters
+    .map((ch, i) => (/[a-zA-Z]/.test(ch) ? i : -1))
+    .filter((i) => i !== -1);
+
+  // Determine how many to blank
+  const target = Math.round(alphaIndices.length * (BLANK_RATIO_MIN + Math.random() * (BLANK_RATIO_MAX - BLANK_RATIO_MIN)));
+  const nBlanks = Math.max(MIN_BLANKS, Math.min(MAX_BLANKS, target, alphaIndices.length));
+
+  // Pick random indices among alpha positions (no duplicates, maintain order)
+  const shuffled = [...alphaIndices].sort(() => Math.random() - 0.5);
+  const blankSet = new Set(shuffled.slice(0, nBlanks));
+
+  const blankedWord = letters.map((letter, i) => ({
+    letter,
+    blanked: blankSet.has(i),
+  }));
+
+  const blankedLetters = letters
+    .filter((_, i) => blankSet.has(i))
+    .join('')
+    .toLowerCase();
+
+  return { blankedWord, blankedLetters };
+}
