+
+  const timerPct = Math.round((timeLeft / TIMER_SECONDS) * 100);
+
+  // Click available chip → move to assembled
+  const handlePickLetter = (chip) => {
+    if (status !== 'playing') return;
+    setAvailable((prev) => prev.filter((c) => c.id !== chip.id));
+    setAssembled((prev) => [...prev, chip]);
+  };
+
+  // Click assembled chip → return to available
+  const handleReturnLetter = (chip) => {
+    if (status !== 'playing') return;
+    setAssembled((prev) => prev.filter((c) => c.id !== chip.id));
+    setAvailable((prev) => [...prev, chip]);
+  };
+
+  const handleClear = () => {
