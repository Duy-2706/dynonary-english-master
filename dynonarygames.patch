+      {
+        word: '',
+        mean: '',
+        phonetic: '',
+        picture: '',
+        example: '',
+      },
+    ],
+    // Câu hỏi trắc nghiệm
+    questions: [
+      {
+        question: '',
+        options: [],            // string[]
+        correctIndex: 0,
+        explanation: '',
+        timeLimit: 30,
+      },
+    ],
+    // Bài tập điền vào chỗ trống
+    fillBlanks: [
+      {
+        sentence: '',
+        correctAnswer: '',
+        hint: '',
+      },
+    ],
+    createdAt: new Date(),
+    updatedAt: new Date(),
+    _isTemplate: true,
+  },
+
+  // ── enrollments ───────────────────────────────────────────────────────────
+  [COLLECTIONS.ENROLLMENTS]: {
+    courseId: '__template_course_id__',
+    studentAccountId: '__template_account_id__',
+    studentName: 'Template Student',
+    status: 'active',           // 'active' | 'pending' | 'cancelled'
+    paymentStatus: 'free',      // 'free' | 'pending' | 'paid'
+    paidAmount: 0,
+    totalLessons: 0,
+    completedLessons: 0,
+    progressPercent: 0,
+    enrolledAt: new Date(),
+    completedAt: null,
+    _isTemplate: true,
+  },
+
+  // ── lessonProgress ────────────────────────────────────────────────────────
+  [COLLECTIONS.LESSON_PROGRESS]: {
+    lessonId: '__template_lesson_id__',
+    courseId: '__template_course_id__',
+    studentAccountId: '__template_account_id__',
+    status: 'in_progress',      // 'in_progress' | 'completed'
+    score: 0,
+    maxScore: 0,
+    correctCount: 0,
+    totalCount: 0,
+    knownWords: [],             // string[]
+    unknownWords: [],           // string[]
+    startedAt: null,
+    completedAt: null,
+    updatedAt: new Date(),
+    _isTemplate: true,
+  },
+
+  // ── classrooms ────────────────────────────────────────────────────────────
+  [COLLECTIONS.CLASSROOMS]: {
+    teacherAccountId: '__template_account_id__',
+    teacherUsername: 'template_teacher',
+    name: '_Template Classroom',
+    description: '',
+    level: 'A1',
+    classCode: 'TMPL01',        // 6-char unique code
+    status: 'active',           // 'active' | 'inactive'
+    students: [],               // string[] — accountId array
+    createdAt: new Date(),
+    updatedAt: new Date(),
+    _isTemplate: true,
+  },
+};
+
+// ─── helpers ─────────────────────────────────────────────────────────────────
+
+const TEMPLATE_DOC_IDS = {}; // collectionName → docId (để cleanup)
+
+async function createTemplateDoc(collectionName, data) {
+  const col = db.collection(collectionName);
+
+  // Kiểm tra đã có template chưa
+  const existing = await col.where('_isTemplate', '==', true).limit(1).get();
+  if (!existing.empty) {
+    const docId = existing.docs[0].id;
+    TEMPLATE_DOC_IDS[collectionName] = docId;
+    console.log(`  ✓ ${collectionName}: template đã tồn tại (id: ${docId})`);
+    return;
+  }
+
+  const ref = await col.add(data);
+  TEMPLATE_DOC_IDS[collectionName] = ref.id;
+  console.log(`  ✅ ${collectionName}: tạo template (id: ${ref.id})`);
+}
+
+async function cleanupTemplateDocs() {
+  console.log('\n🗑️  Đang xoá các template documents...\n');
+  const batch = db.batch();
+  let count = 0;
+
+  for (const [collectionName] of Object.entries(TEMPLATES)) {
+    const col = db.collection(collectionName);
+    const snap = await col.where('_isTemplate', '==', true).get();
+    snap.docs.forEach((doc) => {
+      batch.delete(doc.ref);
+      count++;
+      console.log(`  🗑️  ${collectionName}/${doc.id}`);
+    });
+  }
+
+  if (count === 0) {
+    console.log('  (Không tìm thấy template documents nào)');
+    return;
+  }
+
+  await batch.commit();
+  console.log(`\n✅ Đã xoá ${count} template documents.`);
+}
+
+// ─── main ─────────────────────────────────────────────────────────────────────
+
+async function main() {
+  const isCleanup = process.argv.includes('--cleanup');
+
+  console.log('🔥 Dynonary — Firebase Firestore Setup Script');
+  console.log('═'.repeat(50));
+
+  // Test kết nối
+  try {
+    console.log('\n📡 Kiểm tra kết nối Firebase...');
+    await db.collection('_ping').doc('test').set({ ts: new Date() });
+    await db.collection('_ping').doc('test').delete();
+    console.log('  ✅ Kết nối Firebase thành công!\n');
+  } catch (err) {
+    console.error('  ❌ Kết nối Firebase thất bại:', err.message);
+    console.error('  → Kiểm tra lại FIREBASE_* env vars trong .local.env');
+    process.exit(1);
+  }
+
+  if (isCleanup) {
+    await cleanupTemplateDocs();
+    process.exit(0);
+  }
+
+  // Tạo template documents
+  console.log('📦 Tạo template documents cho từng collection:\n');
+  for (const [collectionName, templateData] of Object.entries(TEMPLATES)) {
+    await createTemplateDoc(collectionName, templateData);
+  }
+
+  console.log('\n' + '═'.repeat(50));
+  console.log('✅ Setup hoàn tất!\n');
+  console.log('📋 Tóm tắt:');
+  console.log(`  • ${Object.keys(TEMPLATES).length} collections đã được khởi tạo`);
+  console.log('  • Mỗi collection có 1 document mẫu với đúng cấu trúc từ ERD');
+  console.log('  • Document mẫu có trường _isTemplate: true\n');
+  console.log('🔧 Bước tiếp theo:');
+  console.log('  1. Vào Firebase Console → Firestore → kiểm tra collections');
+  console.log('  2. Deploy indexes: firebase deploy --only firestore:indexes');
+  console.log('  3. Xoá template docs: node scripts/setupFirestore.js --cleanup');
+  console.log('  4. (Nếu có data MongoDB cũ) chạy: node scripts/migrateFromMongo.js');
+  console.log('\n');
+
+  process.exit(0);
+}
+
+main().catch((err) => {
+  console.error('Lỗi không xử lý được:', err);
+  process.exit(1);
+});
