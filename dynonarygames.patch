+  lessonId,
+  courseId,
+  studentAccountId,
+  data,
+) => {
+  // Upsert lesson progress (findOneAndUpdate with upsert:true)
+  const existing = await progressCol
+    .where('lessonId', '==', lessonId)
+    .where('studentAccountId', '==', studentAccountId)
+    .limit(1)
+    .get();
+
+  let progressId;
